{
  "expo": {
    "name": "Bookmarkit",
    "slug": "bookmarkit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juvialski.bookmarkit",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juvialski.bookmarkit",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bookmarkit to read book covers and barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "./plugins/withLocalBookApi.js",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bookmarkit to read a selected book cover.",
          "cameraPermission": "Allow Bookmarkit to read book covers and barcodes.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "bookmarkit"
  }
}
