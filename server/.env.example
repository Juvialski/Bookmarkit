# Server only. Obtain a legitimate token from https://hardcover.app/account/api
HARDCOVER_API_TOKEN=
PORT=3001

# Supabase Edge Function secrets only; see docs/FREE-GEMINI.md.
# Never use EXPO_PUBLIC_ for Google or service credentials.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_PROJECT_NUMBER=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Set only for a project verified eligible for free 2.5 Search grounding.
GEMINI_GROUNDING_MODEL=
GOOGLE_VERIFIER_SERVICE_ACCOUNT_JSON=
# Advanced multiple-project roster (omit for the simple setup).
# GEMINI_FREE_PROJECTS_JSON=[]
